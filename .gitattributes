# Keep source and project files byte-for-byte consistent across Windows, Linux and macOS.
*.rs     text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.ps1    text eol=lf
*.h      text eol=lf
*.md     text eol=lf
*.json   text eol=lf

# Binary test fixtures.
*.rdlt   binary
